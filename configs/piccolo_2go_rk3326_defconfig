# Piccolo-2go v1.1 Buildroot Defconfig (RK3326 aarch64)
# Audio DACs: HiBy FC3 (£29.61, ES9281 PRO / ES9281AC Pro) primary plus JCALLY JM6 Pro (£12.99, CX31993 + MAX97220) and HiBy Digital D1 (£11.11, CS46L41) backup USB-C DACs.

# --- Target Architecture: Rockchip RK3326 (4x In-Order ARM Cortex-A35, 1 GB LPDDR3) ---
BR2_aarch64=y
BR2_cortex_a35=y
BR2_ARM_FPU_NEON_FP_ARMV8=y
BR2_TARGET_OPTIMIZATION="-O3 -mcpu=cortex-a35 -mtune=cortex-a35 -fomit-frame-pointer"
BR2_SHARED_LIBS=y
BR2_STRIP_strip=y
# BR2_ENABLE_DEBUG is not set
# BR2_PACKAGE_MAN_DB is not set

# --- Bootloader: ARM Trusted Firmware BL31 + U-Boot (RK3326 / Odroid-Go Advance / G350 / R36S) ---
BR2_TARGET_ARM_TRUSTED_FIRMWARE=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_PLATFORM="rk3326"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_BL31=y
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2025.01"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="odroid-go2"
BR2_TARGET_UBOOT_NEEDS_ATF_BL31=y
BR2_TARGET_UBOOT_NEEDS_ATF_BL31_ELF=y
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="idbloader.img u-boot.itb"

# --- Linux Kernel 6.12 (LZ4 Boot Decompression, Tickless 1:2:1 Core Isolation & Pruned Silicon) ---
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.15"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_PICCOLO_2GO_PATH)/board/piccolo-2go/linux-rk3326.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3326-odroid-go2 rockchip/rk3326-odroid-go3"

# --- Immutable Read-Only RootFS (128 KB zstd SquashFS < 140 MB on 64 GB TF1) ---
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS_BS_128K=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PICCOLO_2GO_PATH)/board/piccolo-2go/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_PICCOLO_2GO_PATH)/board/piccolo-2go/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_PICCOLO_2GO_PATH)/board/piccolo-2go/post-image.sh"

# --- Direct KMS/DRM + Mali-G31 MP2 Panfrost GLES 3.0 (Zero X11 / Wayland Overhead) ---
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_PANFROST=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
# BR2_PACKAGE_MESA3D_OPENGL_GLX is not set
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_KMSDRM=y
BR2_PACKAGE_SDL2_OPENGLES=y
# BR2_PACKAGE_SDL2_X11 is not set
# BR2_PACKAGE_SDL2_WAYLAND is not set
BR2_PACKAGE_SDL3=y

# --- Deterministic AX Core, Bit-Perfect Audio, 640x480 Video & Single Bring-Up Emulator (FBNeo) ---
BR2_PACKAGE_AX_SDK=y
BR2_PACKAGE_LIBOPENMPT=y
BR2_PACKAGE_FLAC_AX=y
BR2_PACKAGE_FLAC_AX_APPLIANCE_TUI=y
BR2_PACKAGE_MPV=y
BR2_PACKAGE_RETROARCH=y
BR2_PACKAGE_LIBRETRO_FBNEO=y
BR2_PACKAGE_PICCOLO_2GO_BASE=y
BR2_PACKAGE_PICCOLO_2GO_TOOLS=y
BR2_PACKAGE_DTC=y

# --- Dual-SD (64 GB TF1 ext4 + 128 GB TF2 exFAT/ext4) & LZ4 ZRAM Utilities ---
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_PARTED=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_ZRAMCTL=y

# --- Host Image Assembly Tools (genimage + FAT32 BOOT partition) ---
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y

# --- Purge Desktop & Background Audio Bloat ---
# BR2_PACKAGE_XORG7 is not set
# BR2_PACKAGE_WAYLAND is not set
# BR2_PACKAGE_PIPEWIRE is not set
# BR2_PACKAGE_PULSEAUDIO is not set
# BR2_PACKAGE_QT6 is not set
# BR2_PACKAGE_LSFG_VK is not set
