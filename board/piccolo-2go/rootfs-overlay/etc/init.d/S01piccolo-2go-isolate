#!/bin/sh
# S01piccolo-2go-isolate — Deterministic 1:2:1 RK3326 Core/IRQ Isolation + 512 MB LZ4 ZRAM

case "$1" in
    start)
        echo "[Piccolo-2go] Applying 1:2:1 Cortex-A35 topology & 512 MB LZ4 ZRAM..."

        # 1. Bound tmpfs mounts so logs/temp files never eat into 1 GB LPDDR3
        mount -o remount,size=32M /tmp 2>/dev/null || true
        mount -o remount,size=16M /run 2>/dev/null || true

        # 2. Configure 512 MB LZ4 ZRAM (~650 MB/s in-order Cortex-A35 decompression, zero SD wear)
        if [ -b /dev/zram0 ]; then
            swapoff /dev/zram0 2>/dev/null || true
            echo 1 > /sys/block/zram0/reset 2>/dev/null || true
            echo lz4 > /sys/block/zram0/comp_algorithm 2>/dev/null || true
            echo 536870912 > /sys/block/zram0/disksize 2>/dev/null || true
            mkswap /dev/zram0 >/dev/null 2>&1 && swapon -p 100 /dev/zram0 2>/dev/null || true
        fi
        sysctl -w \
            vm.swappiness=120 \
            vm.page-cluster=0 \
            vm.watermark_boost_factor=0 \
            vm.watermark_scale_factor=125 \
            vm.vfs_cache_pressure=150 >/dev/null 2>&1 || true

        # 3. Steer Audio/USB-OTG/Input IRQs to Core 0 (0x01) and SDMMC DMA IRQs to Core 3 (0x08)
        for irq_dir in /proc/irq/[0-9]*; do
            [ -d "$irq_dir" ] || continue
            if grep -qiE "rk817|i2s|dwc2|usb|gpio|saradc" "$irq_dir"/* 2>/dev/null; then
                echo 1 > "$irq_dir/smp_affinity" 2>/dev/null || true
            elif grep -qiE "dwmmc|mmc" "$irq_dir"/* 2>/dev/null; then
                echo 8 > "$irq_dir/smp_affinity" 2>/dev/null || true
            fi
        done

        # 4. Relax thermal polling to 2000 ms to avoid frame micro-stutter
        for tz in /sys/class/thermal/thermal_zone*/polling_delay; do
            [ -f "$tz" ] && echo 2000 > "$tz" 2>/dev/null || true
        done

        # 5. Balanced governor in menu (boosted to performance during gameplay)
        for gov in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
            [ -f "$gov" ] && echo schedutil > "$gov" 2>/dev/null || true
        done

        mkdir -p /run/lock
        chmod 1777 /run/lock
        ;;
    stop)
        swapoff /dev/zram0 2>/dev/null || true
        sync
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac
exit 0
