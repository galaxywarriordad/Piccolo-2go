#!/bin/sh
# S03piccolo-2go-powerd — Start Core 3 safe KEY_POWER, 75C rollback & 3280 mV battery daemon

set -u

PIDFILE="/run/ax-powerd.pid"

case "${1:-start}" in
    start)
        echo "[Piccolo-2go] Starting Core 3 hardware power & thermal guard (ax-powerd)..."
        start-stop-daemon -S -b -m -p "$PIDFILE" -x /usr/sbin/ax-powerd
        ;;
    stop)
        echo "[Piccolo-2go] Stopping ax-powerd..."
        start-stop-daemon -K -p "$PIDFILE" -x /usr/sbin/ax-powerd 2>/dev/null || true
        rm -f "$PIDFILE"
        ;;
    reload|restart)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|reload}"
        exit 1
        ;;
esac
exit 0
