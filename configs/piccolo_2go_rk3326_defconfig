# Piccolo-2go v1.1 Buildroot Defconfig (RK3326 aarch64)

# Audio DACs: HiBy FC3 (£29.61, ES9281 PRO / ES9281AC Pro) primary plus JCALLY JM6 Pro (£12.99, CX31993 \+ MAX97220) and HiBy Digital D1 (£11.11, CS46L41) backup USB-C DACs.

# \--- Target Architecture: Rockchip RK3326 (4x In-Order ARM Cortex-A35, 1 GB LPDDR3) \---

BR2\_aarch64=y BR2\_cortex\_a35=y BR2\_ARM\_FPU\_NEON\_FP\_ARMV8=y BR2\_TARGET\_OPTIMIZATION="-O3 \-mcpu=cortex-a35 \-mtune=cortex-a35 \-fomit-frame-pointer" BR2\_SHARED\_LIBS=y BR2\_STRIP\_strip=y

# BR2\_ENABLE\_DEBUG is not set

# BR2\_PACKAGE\_MAN\_DB is not set

# \--- Bootloader: ARM Trusted Firmware BL31 \+ U-Boot (RK3326 / Odroid-Go Advance / G350 / R36S) \---

BR2\_TARGET\_ARM\_TRUSTED\_FIRMWARE=y BR2\_TARGET\_ARM\_TRUSTED\_FIRMWARE\_PLATFORM="rk3326" BR2\_TARGET\_ARM\_TRUSTED\_FIRMWARE\_BL31=y BR2\_TARGET\_UBOOT=y BR2\_TARGET\_UBOOT\_BUILD\_SYSTEM\_KCONFIG=y BR2\_TARGET\_UBOOT\_CUSTOM\_VERSION=y BR2\_TARGET\_UBOOT\_CUSTOM\_VERSION\_VALUE="2025.01" BR2\_TARGET\_UBOOT\_BOARD\_DEFCONFIG="odroid-go2" BR2\_TARGET\_UBOOT\_NEEDS\_ATF\_BL31=y BR2\_TARGET\_UBOOT\_NEEDS\_ATF\_BL31\_ELF=y BR2\_TARGET\_UBOOT\_NEEDS\_DTC=y BR2\_TARGET\_UBOOT\_FORMAT\_CUSTOM=y BR2\_TARGET\_UBOOT\_FORMAT\_CUSTOM\_NAME="idbloader.img u-boot.itb"

# \--- Linux Kernel 6.12 (LZ4 Boot Decompression, Tickless 1:2:1 Core Isolation & Pruned Silicon) \---

BR2\_LINUX\_KERNEL=y BR2\_LINUX\_KERNEL\_CUSTOM\_VERSION=y BR2\_LINUX\_KERNEL\_CUSTOM\_VERSION\_VALUE="6.12.15" BR2\_LINUX\_KERNEL\_USE\_ARCH\_DEFAULT\_CONFIG=y BR2\_LINUX\_KERNEL\_CONFIG\_FRAGMENT\_FILES="\$(BR2\_EXTERNAL\_PICCOLO\_2GO\_PATH)/board/piccolo-2go/linux-rk3326.fragment" BR2\_LINUX\_KERNEL\_DTS\_SUPPORT=y BR2\_LINUX\_KERNEL\_INTREE\_DTS\_NAME="rockchip/rk3326-odroid-go2 rockchip/rk3326-odroid-go3"

# \--- Immutable Read-Only RootFS (128 KB zstd SquashFS \< 140 MB on 64 GB TF1) \---

BR2\_TARGET\_ROOTFS\_SQUASHFS=y BR2\_TARGET\_ROOTFS\_SQUASHFS\_BS\_128K=y BR2\_TARGET\_ROOTFS\_SQUASHFS4\_ZSTD=y

# BR2\_TARGET\_ROOTFS\_TAR is not set

BR2\_ROOTFS\_OVERLAY="\$(BR2\_EXTERNAL\_PICCOLO\_2GO\_PATH)/board/piccolo-2go/rootfs-overlay" BR2\_ROOTFS\_POST\_BUILD\_SCRIPT="\$(BR2\_EXTERNAL\_PICCOLO\_2GO\_PATH)/board/piccolo-2go/post-build.sh" BR2\_ROOTFS\_POST\_IMAGE\_SCRIPT="\$(BR2\_EXTERNAL\_PICCOLO\_2GO\_PATH)/board/piccolo-2go/post-image.sh"

# \--- Direct KMS/DRM \+ Mali-G31 MP2 Panfrost GLES 3.0 (Zero X11 / Wayland Overhead) \---

BR2\_PACKAGE\_MESA3D=y BR2\_PACKAGE\_MESA3D\_GALLIUM\_DRIVER\_PANFROST=y BR2\_PACKAGE\_MESA3D\_OPENGL\_ES=y

# BR2\_PACKAGE\_MESA3D\_OPENGL\_GLX is not set

BR2\_PACKAGE\_SDL2=y BR2\_PACKAGE\_SDL2\_KMSDRM=y BR2\_PACKAGE\_SDL2\_OPENGLES=y

# BR2\_PACKAGE\_SDL2\_X11 is not set

# BR2\_PACKAGE\_SDL2\_WAYLAND is not set

BR2\_PACKAGE\_SDL3=y

# \--- Deterministic AX Core, Bit-Perfect Audio, 640x480 Video & Single Bring-Up Emulator (FBNeo) \---

BR2\_PACKAGE\_AX\_SDK=y BR2\_PACKAGE\_LIBOPENMPT=y BR2\_PACKAGE\_FLAC\_AX=y BR2\_PACKAGE\_FLAC\_AX\_APPLIANCE\_TUI=y BR2\_PACKAGE\_MPV=y BR2\_PACKAGE\_RETROARCH=y BR2\_PACKAGE\_LIBRETRO\_FBNEO=y BR2\_PACKAGE\_PICCOLO\_2GO\_BASE=y BR2\_PACKAGE\_PICCOLO\_2GO\_TOOLS=y BR2\_PACKAGE\_DTC=y

# \--- Dual-SD (64 GB TF1 ext4 \+ 128 GB TF2 exFAT/ext4) & LZ4 ZRAM Utilities \---

BR2\_PACKAGE\_EXFATPROGS=y BR2\_PACKAGE\_E2FSPROGS=y BR2\_PACKAGE\_PARTED=y BR2\_PACKAGE\_UTIL\_LINUX=y BR2\_PACKAGE\_UTIL\_LINUX\_ZRAMCTL=y

# \--- Host Image Assembly Tools (genimage \+ FAT32 BOOT partition) \---

BR2\_PACKAGE\_HOST\_GENIMAGE=y BR2\_PACKAGE\_HOST\_DOSFSTOOLS=y BR2\_PACKAGE\_HOST\_MTOOLS=y

# \--- Purge Desktop & Background Audio Bloat \---

# BR2\_PACKAGE\_XORG7 is not set

# BR2\_PACKAGE\_WAYLAND is not set

# BR2\_PACKAGE\_PIPEWIRE is not set

# BR2\_PACKAGE\_PULSEAUDIO is not set

# BR2\_PACKAGE\_QT6 is not set

# BR2\_PACKAGE\_LSFG\_VK is not set
