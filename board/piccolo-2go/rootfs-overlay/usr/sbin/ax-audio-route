#!/bin/sh
# ax-audio-route — Primary HiBy FC3 (1.3 Vrms) & Backup USB DAC (JM6 Pro / HiBy D1) OTG router

ENV_DIR="/run/ax"
ENV_FILE="${ENV_DIR}/audio.env"
mkdir -p "$ENV_DIR"

detect_hiby_fc3() {
    grep -qiE "FC3|HiBy" /proc/asound/cards 2>/dev/null
}

detect_backup_usb_card() {
    # Match any non-RK817 sound card entry in /proc/asound/cards (e.g., JM6 Pro / HiBy D1 / USB DAC)
    awk '
        /^[[:space:]]*[0-9]+[[:space:]]+\[/ {
            line = $0
            if (line ~ /rockchiprk817|RK817/) next
            match(line, /\[[^]]+\]/)
            if (RSTART > 0) {
                card = substr(line, RSTART + 1, RLENGTH - 2)
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", card)
                if (length(card) > 0) {
                    print card
                    exit 0
                }
            }
        }
    ' /proc/asound/cards 2>/dev/null
}

mute_rk817_speaker() {
    if command -v amixer >/dev/null 2>&1; then
        amixer -c rockchiprk817 -q set 'Playback' 0 2>/dev/null || true
        amixer -c rockchiprk817 -q set 'Playback Path' 'OFF' 2>/dev/null || true
        amixer -c rockchiprk817 -q set 'Playback' 0 2>/dev/null || true
    fi
}

write_fc3_profile() {
    mute_rk817_speaker
    cat > "$ENV_FILE" << 'EOF'
ALSA_DEV=hw:CARD=FC3,DEV=0
MIXER_CARD=FC3
CHIP_PROFILE=fc3_1v3
DEFAULT_VOL=0.65
DAC_STATE=CONNECTED
EOF
    echo "[ax-audio-route] Primary HiBy FC3 (1.3 Vrms) locked on hw:CARD=FC3,DEV=0 (fc3_1v3)"
}

write_backup_usb_profile() {
    card_name="$1"
    mute_rk817_speaker
    cat > "$ENV_FILE" << EOF
ALSA_DEV=hw:CARD=${card_name},DEV=0
MIXER_CARD=${card_name}
CHIP_PROFILE=usb_backup
DEFAULT_VOL=0.45
DAC_STATE=CONNECTED
EOF
    echo "[ax-audio-route] Backup USB DAC locked on hw:CARD=${card_name},DEV=0 (usb_backup, default vol=0.45)"
}

write_rk817_fallback() {
    if command -v amixer >/dev/null 2>&1; then
        amixer -c rockchiprk817 -q set 'Playback' 0 2>/dev/null || true
        amixer -c rockchiprk817 -q set 'Playback Path' 'SPK' 2>/dev/null || true
        sleep 0.2
        amixer -c rockchiprk817 -q set 'Playback' 85% 2>/dev/null || true
    fi
    cat > "$ENV_FILE" << 'EOF'
ALSA_DEV=hw:CARD=rockchiprk817,DEV=0
MIXER_CARD=rockchiprk817
CHIP_PROFILE=rk817
DEFAULT_VOL=0.85
DAC_STATE=FALLBACK_RK817
EOF
    echo "[ax-audio-route] No USB DAC attached — using internal RK817 (3.5 mm / Mono Speaker)"
}

apply_audio_routing() {
    if detect_hiby_fc3; then
        write_fc3_profile
        return 0
    fi

    backup_card=$(detect_backup_usb_card)
    if [ -n "$backup_card" ]; then
        write_backup_usb_profile "$backup_card"
        return 0
    fi

    write_rk817_fallback
}

case "${1:-apply}" in
    apply)
        apply_audio_routing
        ;;
    prompt)
        while [ ! -f "$ENV_FILE" ] || ! grep -q "DAC_STATE=CONNECTED" "$ENV_FILE" 2>/dev/null; do
            apply_audio_routing
            if grep -q "DAC_STATE=CONNECTED" "$ENV_FILE" 2>/dev/null; then
                break
            fi
            printf '\n\033[1;33m[Piccolo-2go] USB-C DAC (HiBy FC3 primary, or JM6 Pro / HiBy Digital D1 backup) not detected.\033[0m\n'
            printf '  Plug your USB-C DAC into the USB-C OTG port now, then:\n'
            printf '    [R] Retry DAC detection\n'
            printf '    [S] Skip and use internal RK817 (3.5 mm jack / mono speaker)\n'
            printf '  Choice [R/s]: '
            read -r choice </dev/tty 2>/dev/null || choice="s"
            case "$choice" in
                s|S)
                    write_rk817_fallback
                    exit 0
                    ;;
                *)
                    echo "[ax-audio-route] Probing USB-C OTG bus..."
                    sleep 1
                    ;;
            esac
        done
        ;;
    *)
        echo "Usage: $0 {apply|prompt}"
        exit 1
        ;;
esac
exit 0
