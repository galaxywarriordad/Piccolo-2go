#!/bin/sh
# S01piccolo-2go-isolate — Deterministic 1:2:1 RK3326 Isolation, Safe PLL Steps (1.30/1.34/1.39 GHz),
#                          1024 MB LZ4 ZRAM, Mali-G31 Cache, Bootloader DDR/CPU Config & Safe Recovery

apply_cpu_max_khz() {
    target_khz="$1"
    for cpu_dir in /sys/devices/system/cpu/cpu[0-9]*/cpufreq; do
        [ -d "$cpu_dir" ] || continue
        echo "$target_khz" > "$cpu_dir/scaling_max_freq" 2>/dev/null || true
    done
}

apply_governors_121() {
    # Cores 0-2 (0x07): performance for deterministic audio/IRQs, GPU/scanout, and emulation/DSP
    # Core 3 (0x08): schedutil for housekeeping, ZRAM, and SDMMC DMA
    for cpu in 0 1 2; do
        gov_file="/sys/devices/system/cpu/cpu${cpu}/cpufreq/scaling_governor"
        [ -f "$gov_file" ] && echo performance > "$gov_file" 2>/dev/null || true
    done
    if [ -f /sys/devices/system/cpu/cpu3/cpufreq/scaling_governor ]; then
        echo schedutil > /sys/devices/system/cpu/cpu3/cpufreq/scaling_governor 2>/dev/null || true
    fi
}

apply_led_mode() {
    mode="$1"
    for led_dir in /sys/class/leds/*; do
        [ -d "$led_dir" ] || continue
        if [ "$mode" = "off" ]; then
            echo none > "$led_dir/trigger" 2>/dev/null || true
            echo 0 > "$led_dir/brightness" 2>/dev/null || true
        else
            echo heartbeat > "$led_dir/trigger" 2>/dev/null || true
        fi
    done
}

read_conf_val() {
    key="$1"
    default_val="$2"
    for conf_file in /boot/ax-2go.conf /boot/boot.ini; do
        [ -f "$conf_file" ] || continue
        val=$(grep -E "^[[:space:]]*${key}=" "$conf_file" 2>/dev/null | tail -n 1 | cut -d'=' -f2 | tr -d ' \r\t"')
        if [ -n "$val" ]; then
            echo "$val"
            return 0
        fi
    done
    echo "$default_val"
}

resolve_target_ddr_mhz() {
    safe_mode="$1"
    ddr_mode=$(read_conf_val "AX_DDR_MODE" "")
    ddr_freq=$(read_conf_val "DDR_FREQ" "720")
    allow_high=$(read_conf_val "ALLOW_HIGH_DDR" "0")

    if [ "$safe_mode" -eq 1 ]; then
        echo "666"
        return 0
    fi

    case "$ddr_mode" in
        safe|low)
            echo "666"
            return 0
            ;;
        default|normal)
            echo "720"
            return 0
            ;;
        high)
            case "$ddr_freq" in
                800|900)
                    if [ "$allow_high" = "1" ] || [ "$allow_high" = "yes" ] || [ "$allow_high" = "true" ]; then
                        echo "$ddr_freq"
                        return 0
                    fi
                    ;;
                *)
                    if [ "$allow_high" = "1" ] || [ "$allow_high" = "yes" ] || [ "$allow_high" = "true" ]; then
                        echo "800"
                        return 0
                    fi
                    ;;
            esac
            echo "720"
            return 0
            ;;
    esac

    case "$ddr_freq" in
        666|720)
            echo "$ddr_freq"
            ;;
        800|900)
            if [ "$allow_high" = "1" ] || [ "$allow_high" = "yes" ] || [ "$allow_high" = "true" ]; then
                echo "$ddr_freq"
            else
                echo "720"
            fi
            ;;
        *)
            echo "720"
            ;;
    esac
}

update_boot_ini_ddr() {
    target_mhz="$1"
    boot_ini="/boot/boot.ini"
    [ -f "$boot_ini" ] && [ -w "$boot_ini" ] || return 0
    grep -q "max_ddrfreq=" "$boot_ini" 2>/dev/null || return 0
    grep -q "max_ddrfreq=${target_mhz}\b" "$boot_ini" 2>/dev/null && return 0

    tmp_ini="/run/ax/boot.ini.tmp.$$"
    sed "s/max_ddrfreq=[0-9]*/max_ddrfreq=${target_mhz}/g" "$boot_ini" > "$tmp_ini" 2>/dev/null || {
        rm -f "$tmp_ini"
        return 0
    }
    if [ -s "$tmp_ini" ] && ! cmp -s "$boot_ini" "$tmp_ini" 2>/dev/null; then
        cat "$tmp_ini" > "$boot_ini" 2>/dev/null || true
        sync
    fi
    rm -f "$tmp_ini"
}

restore_golden_dtb() {
    golden_dtb="/boot/recovery/rk3326-g350-linux.dtb"
    fallback_dtb="/boot/dtbs/rk3326-g350-linux.dtb"
    active_dtb="/boot/rk3326-g350-linux.dtb"
    src_dtb=""
    if [ -f "$golden_dtb" ]; then
        src_dtb="$golden_dtb"
    elif [ -f "$fallback_dtb" ]; then
        src_dtb="$fallback_dtb"
    fi

    if [ -n "$src_dtb" ] && [ -w /boot ]; then
        if [ ! -f "$active_dtb" ] || ! cmp -s "$src_dtb" "$active_dtb" 2>/dev/null; then
            cp -f "$src_dtb" "$active_dtb" 2>/dev/null || true
            sync
        fi
    fi
}

steer_irqs_121() {
    for irq_dir in /proc/irq/[0-9]*; do
        [ -d "$irq_dir" ] && [ -w "$irq_dir/smp_affinity" ] || continue
        actions_file="$irq_dir/actions"
        [ -r "$actions_file" ] || continue

        if grep -qiE "(^|[^a-z0-9])(dwc2|rk817|i2s|gpio|saradc)([^a-z0-9]|$)" "$actions_file" 2>/dev/null; then
            echo 1 > "$irq_dir/smp_affinity" 2>/dev/null || true
        elif grep -qiE "(^|[^a-z0-9])(dwmmc|dw-mmc|mmc0|mmc1)([^a-z0-9]|$)" "$actions_file" 2>/dev/null; then
            echo 8 > "$irq_dir/smp_affinity" 2>/dev/null || true
        fi
    done
}

case "$1" in
    start)
        echo "[Piccolo-2go] Applying 1:2:1 Cortex-A35 topology, 1024 MB LZ4 ZRAM & Mali-G31 cache..."

        # 0. Bound tmpfs mounts early so temp files and shader cache stay in RAM
        mount -o remount,size=32M /tmp 2>/dev/null || true
        mount -o remount,size=16M /run 2>/dev/null || true
        mkdir -p /tmp/mesa_shader_cache /run/ax /run/lock
        chmod 1777 /tmp/mesa_shader_cache /run/lock

        # 1. Hold-Button Safe Recovery Check (SELECT / FN / B held during boot)
        SAFE_RECOVERY=0
        if command -v ax-boot-recovery >/dev/null 2>&1 && ax-boot-recovery; then
            SAFE_RECOVERY=1
            touch /run/ax-safe-recovery
            if [ -w /dev/tty1 ]; then
                printf '\n\033[1;33m[Piccolo-2go] SAFE RECOVERY TRIGGERED (Button Held) — Locking 1.30 GHz CPU, 666 MHz DDR3 & Default DTB!\033[0m\n' > /dev/tty1 2>/dev/null || true
            fi
            restore_golden_dtb
        fi

        # 2. Detect active RK3326 board variant (G350 vs R36S/R36H/R46H analog MUX & inversion profile)
        BOARD_COMPAT=$(tr '\0' ' ' < /proc/device-tree/compatible 2>/dev/null || echo "g350")
        case "$BOARD_COMPAT" in
            *r36h*) BOARD_ID="r36h" ;;
            *r46h*) BOARD_ID="r46h" ;;
            *r36s*) BOARD_ID="r36s" ;;
            *)      BOARD_ID="g350" ;;
        esac
        echo "AX_BOARD_ID=${BOARD_ID}" > /run/ax/board.env

        # 3. Enforce madvise Transparent HugePages for large FBNeo ROM arenas (32x fewer TLB misses)
        if [ -f /sys/kernel/mm/transparent_hugepage/enabled ]; then
            echo madvise > /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null || true
        fi

        # 4. Configure 1024 MB LZ4 ZRAM (~650 MB/s in-order Cortex-A35 decompression, zero SD wear)
        if [ -b /dev/zram0 ]; then
            swapoff /dev/zram0 2>/dev/null || true
            echo 1 > /sys/block/zram0/reset 2>/dev/null || true
            echo lz4 > /sys/block/zram0/comp_algorithm 2>/dev/null || true
            echo 1073741824 > /sys/block/zram0/disksize 2>/dev/null || true
            mkswap /dev/zram0 >/dev/null 2>&1 && swapon -p 100 /dev/zram0 2>/dev/null || true
        fi
        sysctl -w \
            vm.swappiness=120 \
            vm.page-cluster=0 \
            vm.watermark_boost_factor=0 \
            vm.watermark_scale_factor=125 \
            vm.vfs_cache_pressure=150 >/dev/null 2>&1 || true

        # 5. Narrow IRQ steering to audio/OTG/input (Core 0 -> 1) and SDMMC (Core 3 -> 8)
        steer_irqs_121

        # 6. Apply bootloader / ax-2go.conf overrides (CPU_PROFILE, AX_DDR_MODE / DDR_FREQ, LED_MODE, GPU_IDLE_GOV)
        CPU_PROF=$(read_conf_val "CPU_PROFILE" "1.30")
        LED_REQ=$(read_conf_val "LED_MODE" "off")
        GPU_GOV=$(read_conf_val "GPU_IDLE_GOV" "simple_ondemand")
        TARGET_DDR=$(resolve_target_ddr_mhz "$SAFE_RECOVERY")
        update_boot_ini_ddr "$TARGET_DDR"

        MAX_KHZ=1296000
        PROFILE_LABEL="1.296 GHz / 1.30 GHz (Official Stock Safe)"
        if [ "$SAFE_RECOVERY" -eq 0 ]; then
            case "$CPU_PROF" in
                1.39|1392000)
                    MAX_KHZ=1392000
                    PROFILE_LABEL="1.392 GHz / 1.39 GHz (High PLL Step +96 MHz)"
                    ;;
                1.34|1344000)
                    MAX_KHZ=1344000
                    PROFILE_LABEL="1.344 GHz / 1.34 GHz (Sweet-Spot PLL Step +48 MHz)"
                    ;;
            esac
        fi

        echo "[Piccolo-2go] Board: ${BOARD_ID} | CPU: ${PROFILE_LABEL} | DDR: ${TARGET_DDR} MHz | LED: ${LED_REQ}"
        apply_cpu_max_khz "$MAX_KHZ"
        apply_governors_121

        apply_led_mode "$LED_REQ"
        echo "$GPU_GOV" > /sys/class/devfreq/ff400000.gpu/governor 2>/dev/null || true

        # 7. Pop-free RK817 internal codec initialization (zero speaker pop on boot)
        if command -v amixer >/dev/null 2>&1; then
            amixer -q set 'Playback' 0 2>/dev/null || true
            amixer -q set 'Playback Path' 'SPK' 2>/dev/null || true
            sleep 0.2
            amixer -q set 'Playback' 85% 2>/dev/null || true
        fi

        # 8. Relax thermal polling to 2000 ms to avoid frame micro-stutter
        for tz in /sys/class/thermal/thermal_zone*/polling_delay; do
            [ -f "$tz" ] && echo 2000 > "$tz" 2>/dev/null || true
        done
        ;;
    set-1.30|set-1.3)
        apply_cpu_max_khz 1296000
        echo "[Piccolo-2go] Switched CPU ceiling to 1.296 GHz / 1.30 GHz (1296000 kHz)"
        ;;
    set-1.34)
        apply_cpu_max_khz 1344000
        echo "[Piccolo-2go] Switched CPU ceiling to 1.344 GHz / 1.34 GHz (1344000 kHz)"
        ;;
    set-1.39)
        apply_cpu_max_khz 1392000
        echo "[Piccolo-2go] Switched CPU ceiling to 1.392 GHz / 1.39 GHz (1392000 kHz)"
        ;;
    gpu-perf)
        echo performance > /sys/class/devfreq/ff400000.gpu/governor 2>/dev/null || true
        ;;
    gpu-auto)
        echo simple_ondemand > /sys/class/devfreq/ff400000.gpu/governor 2>/dev/null || true
        ;;
    stop)
        swapoff /dev/zram0 2>/dev/null || true
        sync
        ;;
    *)
        echo "Usage: $0 {start|stop|set-1.30|set-1.34|set-1.39|gpu-perf|gpu-auto}"
        exit 1
        ;;
esac
exit 0
```[cite: 19, 20, 21]

