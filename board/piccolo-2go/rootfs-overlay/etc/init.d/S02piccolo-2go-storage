#!/bin/sh
# S02piccolo-2go-storage — Dual SanDisk Extreme PRO (64 GB TF1 + 128 GB TF2) Mounter & SDR50 Bus Guard

warn_tty() {
    msg="$1"
    echo "[Piccolo-2go][WARN] ${msg}" >&2
    if [ -w /dev/tty1 ]; then
        printf '\033[1;33m[Piccolo-2go][WARN] %s\033[0m\n' "$msg" > /dev/tty1 2>/dev/null || true
    fi
}

tune_block_queue() {
    dev_name="$1"
    ra_kb="$2"
    qdir="/sys/block/${dev_name}/queue"
    [ -d "$qdir" ] || return 0
    echo none > "${qdir}/scheduler" 2>/dev/null || echo mq-deadline > "${qdir}/scheduler" 2>/dev/null || true
    echo "$ra_kb" > "${qdir}/read_ahead_kb" 2>/dev/null || true
    echo 0 > "${qdir}/add_random" 2>/dev/null || true
    echo 1 > "${qdir}/nomerges" 2>/dev/null || true
}

check_and_enforce_sdr50() {
    slot_label="$1"   # TF1 or TF2
    mmc_host="$2"     # mmc0 or mmc1
    dtb_node="$3"     # /dwmmc@ff370000 or /dwmmc@ff390000
    dtb_file="/boot/rk3326-g350-linux.dtb"

    ios_file="/sys/kernel/debug/${mmc_host}/ios"
    [ -f "$ios_file" ] || return 0

    timing_line=$(grep -i "timing spec:" "$ios_file" 2>/dev/null || true)

    # Check if kernel logged UHS/SDR tuning or CRC errors on this host
    if dmesg 2>/dev/null | grep -qE "${mmc_host}:.*(tuning.*fail|CRC|error -84|error -110)"; then
        warn_tty "${slot_label} (${mmc_host}) failed UHS tuning/CRC check — locking safe 25 MHz High-Speed fallback!"
        if [ -w "$dtb_file" ] && command -v fdtput >/dev/null 2>&1; then
            fdtput -d "$dtb_file" "$dtb_node" sd-uhs-sdr104 2>/dev/null || true
            fdtput -d "$dtb_file" "$dtb_node" sd-uhs-sdr50 2>/dev/null || true
            sync
        fi
        sleep 2
        return 0
    fi

    # Strip unstable SDR104 on fixed-3.3V VQMMC boards and ensure SDR50 (50 MHz) is enabled if supported
    case "$timing_line" in
        *"SDR50"*|*"SDR104"*)
            echo "[Piccolo-2go] ${slot_label} (${mmc_host}) verified UHS active: ${timing_line}"
            ;;
        *)
            if [ -w "$dtb_file" ] && command -v fdtput >/dev/null 2>&1; then
                fdtput -d "$dtb_file" "$dtb_node" sd-uhs-sdr104 2>/dev/null || true
                fdtput -t empty "$dtb_file" "$dtb_node" sd-uhs-sdr50 2>/dev/null || true
                sync
                echo "[Piccolo-2go] ${slot_label} (${mmc_host}) enabled sd-uhs-sdr50 (50 MHz) in DTB for next boot."
            else
                warn_tty "${slot_label} (${mmc_host}) running in slower 25 MHz High-Speed mode (${timing_line:-unknown})."
                sleep 2
            fi
            ;;
    esac
}

case "$1" in
    start)
        echo "[Piccolo-2go] Mounting dual SanDisk Extreme PRO storage (64 GB TF1 + 128 GB TF2)..."
        mkdir -p /userdata /mnt/tf2

        # Detect boot SD block device dynamically (typically /dev/mmcblk0)
        ROOT_SRC=$(awk '$2 == "/" {print $1; exit}' /proc/mounts)
        case "$ROOT_SRC" in
            /dev/mmcblk0p*) SYS_DEV="/dev/mmcblk0"; SYS_BLK="mmcblk0"; MEDIA_PART="/dev/mmcblk1p1"; MEDIA_BLK="mmcblk1" ;;
            /dev/mmcblk1p*) SYS_DEV="/dev/mmcblk1"; SYS_BLK="mmcblk1"; MEDIA_PART="/dev/mmcblk0p1"; MEDIA_BLK="mmcblk0" ;;
            *)              SYS_DEV="/dev/mmcblk0"; SYS_BLK="mmcblk0"; MEDIA_PART="/dev/mmcblk1p1"; MEDIA_BLK="mmcblk1" ;;
        esac
        SYS_PART="${SYS_DEV}p3"

        # 1. Tune block queue & verify SDR50 (50 MHz) bus mode on TF1 (64 GB OS slot)
        tune_block_queue "$SYS_BLK" 256
        check_and_enforce_sdr50 "TF1 (64GB OS)" "mmc0" "/dwmmc@ff370000"

        # 2. Auto-expand & format TF1 p3 (64 GB SanDisk Extreme PRO) on first boot without rebooting
        if [ -b "$SYS_PART" ]; then
            if ! blkid "$SYS_PART" >/dev/null 2>&1; then
                parted -s "$SYS_DEV" resizepart 3 100% 2>/dev/null || true
                partprobe "$SYS_DEV" 2>/dev/null || true
                mkfs.ext4 -F -L PICCOLO_SYS "$SYS_PART" >/dev/null 2>&1 || true
            fi
            mount -t ext4 -o noatime,nodiratime,commit=60,data=writeback "$SYS_PART" /userdata 2>/dev/null || true
        fi

        mkdir -p /userdata/roms /userdata/music /userdata/bios /userdata/saves /userdata/configs

        # 3. Probe TF2 (128 GB SanDisk Extreme PRO), verify SDR50 & bind-mount media library
        if [ -b "$MEDIA_PART" ]; then
            tune_block_queue "$MEDIA_BLK" 512
            check_and_enforce_sdr50 "TF2 (128GB Media)" "mmc1" "/dwmmc@ff390000"

            FSTYPE=$(blkid -o value -s TYPE "$MEDIA_PART" 2>/dev/null || echo "exfat")
            if [ "$FSTYPE" = "ext4" ]; then
                mount -t ext4 -o noatime,nodiratime,commit=60 "$MEDIA_PART" /mnt/tf2 2>/dev/null || true
            else
                mount -t exfat -o noatime,nodiratime,uid=0,gid=0,umask=0000 "$MEDIA_PART" /mnt/tf2 2>/dev/null || true
            fi

            if mountpoint -q /mnt/tf2; then
                for sub in roms music bios; do
                    mkdir -p "/mnt/tf2/${sub}" "/userdata/${sub}"
                    mount --bind "/mnt/tf2/${sub}" "/userdata/${sub}" 2>/dev/null || true
                done
                echo "[Piccolo-2go] TF2 (128 GB media card) bound to /userdata/{roms,music,bios}"
            fi
        fi
        ;;
    stop)
        sync
        for sub in roms music bios; do
            umount "/userdata/${sub}" 2>/dev/null || true
        done
        umount /mnt/tf2 2>/dev/null || true
        umount /userdata 2>/dev/null || true
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac
exit 0
