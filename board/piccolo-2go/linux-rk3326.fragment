# --- Piccolo-2go RK3326 (BATLEXP G350 & R36S) Silicon & Memory Optimization Fragment ---

# 1. Fast LZ4 Kernel Boot (< 180 ms), Tickless 1:2:1 Core Isolation & Preemption
CONFIG_KERNEL_LZ4=y
CONFIG_PREEMPT=y
CONFIG_NO_HZ_FULL=y
CONFIG_RCU_NOCB_CPU=y
CONFIG_HIGH_RES_TIMERS=y

# 2. Shrink CMA to 64 MB & Disable Unused Multimedia/Crypto Silicon
CONFIG_CMA_SIZE_MBYTES=64
# CONFIG_VIDEO_ROCKCHIP_VPU is not set
# CONFIG_VIDEO_ROCKCHIP_ISP1 is not set
# CONFIG_VIDEO_ROCKCHIP_RGA is not set
# CONFIG_CRYPTO_DEV_ROCKCHIP is not set

# 3. Audio: Keep I2S0 (RK817) + USB Audio/MIDI (HiBy FC3 1.3 Vrms), Strip Unused I2S1/PDM
CONFIG_SND_SOC_ROCKCHIP_I2S=y
CONFIG_SND_SOC_RK817=y
# CONFIG_SND_SOC_ROCKCHIP_I2S_TDM is not set
# CONFIG_SND_SOC_ROCKCHIP_PDM is not set
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_USB_MIDI=y
CONFIG_SND_RAWMIDI=y

# 4. 512 MB LZ4 ZRAM (~650 MB/s In-Order Cortex-A35 Decompression) + Single-Page Swap
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_LZ4_COMPRESS=y
CONFIG_LZ4_DECOMPRESS=y

# 5. Dual SanDisk Extreme PRO (TF1 64 GB ext4 + TF2 128 GB exFAT/ext4), Strip eMMC/NAND
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_EXT4_FS=y
CONFIG_EXFAT_FS=y
CONFIG_VFAT_FS=y
# CONFIG_MTD is not set

# 6. Modular USB-C OTG Peripherals (0 KB RAM when unplugged)
CONFIG_USB_DWC2=y
CONFIG_USB_HID=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_MT7601U=m
CONFIG_RTL8XXXU=m

# 7. Strip Non-Swappable Kernel Debug/Audit/IPv6 Bloat (~15 MB LPDDR3 Saved)
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_PROFILING is not set
# CONFIG_AUDIT is not set
# CONFIG_IPV6 is not set
# CONFIG_BT is not set
