# In S01piccolo-2go-isolate start), apply CPU_PROFILE overrides after setting the HW_PROFILE baseline
# (unless SAFE_RECOVERY=1), so explicit CPU_PROFILE=1.30 / 1.34 / 1.39 always takes effect:
MAX_KHZ=1344000
PROFILE_LABEL="1.344 GHz / 1.34 GHz (Default Mode)"
case "$HW_PROF" in
    safe)
        MAX_KHZ=1296000
        PROFILE_LABEL="1.296 GHz / 1.30 GHz (Safe Mode / Audio Floor)"
        ;;
    oc_boost)
        MAX_KHZ=1392000
        PROFILE_LABEL="1.392 GHz / 1.39 GHz (OC/Boost Mode)"
        ;;
    default)
        MAX_KHZ=1344000
        PROFILE_LABEL="1.344 GHz / 1.34 GHz (Default Mode)"
        ;;
esac

if [ "$SAFE_RECOVERY" -eq 0 ]; then
    case "$CPU_PROF" in
        1.30|1.3|1296000)
            MAX_KHZ=1296000
            PROFILE_LABEL="1.296 GHz / 1.30 GHz (CPU_PROFILE Override)"
            ;;
        1.34|1344000)
            MAX_KHZ=1344000
            PROFILE_LABEL="1.344 GHz / 1.34 GHz (CPU_PROFILE Override)"
            ;;
        1.39|1392000)
            MAX_KHZ=1392000
            PROFILE_LABEL="1.392 GHz / 1.39 GHz (CPU_PROFILE Override)"
            ;;
    esac
fi
