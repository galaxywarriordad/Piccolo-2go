#!/bin/sh
# /etc/init.d/S01piccolo-2go-isolate
# Piccolo-2go (RK3326 aarch64) 1:2:1 core/IRQ isolation, DTB profile & ZRAM setup

set -u

LOG_TAG="piccolo-2go-isolate"
BOOT_CFG="/boot/piccolo-2go.conf"
DTB_DIR="/boot/dtbs"

log_info() {
  logger -t "$LOG_TAG" "$1" 2>/dev/null || printf "[%s] %s\n" "$LOG_TAG" "$1"
}

# 1. Safe-recovery DTB restore & profile selection (safe | default | oc_boost)
apply_dtb_profile() {
  profile="${1:-default}"
  case "$profile" in
    safe|default|oc_boost) ;;
    *) profile="default" ;;
  esac

  if [ -d "$DTB_DIR" ] && [ -w /boot ]; then
    if [ -f "$DTB_DIR/rk3326-piccolo-2go-${profile}.dtb" ] && [ -w /boot/rk3326-piccolo-2go.dtb ]; then
      cp -f "$DTB_DIR/rk3326-piccolo-2go-${profile}.dtb" /boot/rk3326-piccolo-2go.dtb 2>/dev/null || true
      log_info "Applied RK3326 DTB profile: $profile"
    fi
  fi
}

# 2. CPU governors across 1:2:1 (Cores 0-2 RT/GPU/FBNeo -> performance; Core 3 I/O -> schedutil)
tune_cpu_governors() {
  for cpu in 0 1 2; do
    gov_path="/sys/devices/system/cpu/cpu${cpu}/cpufreq/scaling_governor"
    [ -w "$gov_path" ] && printf 'performance\n' > "$gov_path" 2>/dev/null || true
  done
  if [ -w /sys/devices/system/cpu/cpu3/cpufreq/scaling_governor ]; then
    printf 'schedutil\n' > /sys/devices/system/cpu/cpu3/cpufreq/scaling_governor 2>/dev/null || true
  fi
}

# 3. 1024 MB LZ4 ZRAM setup
setup_zram_1024m() {
  if [ ! -e /dev/zram0 ]; then
    modprobe zram num_devices=1 2>/dev/null || true
  fi
  if [ -e /dev/zram0 ]; then
    if [ ! -s /sys/block/zram0/disksize ]; then
      swapoff /dev/zram0 2>/dev/null || true
      printf 'lz4\n' > /sys/block/zram0/comp_algorithm 2>/dev/null || true
      printf '1073741824\n' > /sys/block/zram0/disksize 2>/dev/null || true
      mkswap /dev/zram0 >/dev/null 2>&1 || true
      swapon -p 5 /dev/zram0 >/dev/null 2>&1 || true
    fi
  fi
  [ -w /proc/sys/vm/swappiness ] && printf '120\n' > /proc/sys/vm/swappiness 2>/dev/null || true
  [ -w /proc/sys/vm/page-cluster ] && printf '0\n' > /proc/sys/vm/page-cluster 2>/dev/null || true
}

# 4. Pin threaded IRQ handlers (irq/<N>-*) to target CPU
pin_irq_threads_to_cpu() {
  irq_num="$1"
  target_cpu="$2"
  command -v pgrep >/dev/null 2>&1 && command -v taskset >/dev/null 2>&1 || return 0
  for irq_pid in $(pgrep -f "^irq/${irq_num}-" 2>/dev/null || true); do
    taskset -pc "$target_cpu" "$irq_pid" >/dev/null 2>&1 || true
  done
}

# 5. Aligned IRQ steering matching ax_doctor.sh
# Core 0 (0x1): xhci_hcd, dwc2, rk817, i2s, gpio, saradc
# Core 3 (0x8): dwmmc, dw-mmc, mmc0, mmc1, nvme, ahci
steer_ax_irqs() {
  io_cpu="${1:-3}"
  io_mask="${2:-8}"
  for irq_dir in /proc/irq/[0-9]*; do
    [ -d "$irq_dir" ] || continue
    irq_num="${irq_dir##*/}"
    actions_file="$irq_dir/actions"
    aff_file="$irq_dir/smp_affinity"
    [ -r "$actions_file" ] || continue

    if grep -qiE '(^|[^a-z0-9])(xhci_hcd|dwc2|rk817|i2s|gpio|saradc)([^a-z0-9]|$)' "$actions_file" 2>/dev/null; then
      [ -w "$aff_file" ] && printf '1\n' > "$aff_file" 2>/dev/null || true
      pin_irq_threads_to_cpu "$irq_num" 0
    elif grep -qiE '(^|[^a-z0-9])(dwmmc|dw-mmc|mmc0|mmc1|nvme|ahci)([^a-z0-9]|$)' "$actions_file" 2>/dev/null; then
      [ -w "$aff_file" ] && printf '%s\n' "$io_mask" > "$aff_file" 2>/dev/null || true
      pin_irq_threads_to_cpu "$irq_num" "$io_cpu"
    fi
  done
}

case "${1:-start}" in
  start)
    profile="default"
    if [ -r "$BOOT_CFG" ]; then
      cfg_prof="$(awk -F= '/^AX_PROFILE=/{gsub(/["'\''[:space:]]/,"",$2); print $2}' "$BOOT_CFG" | head -n1)"
      [ -n "$cfg_prof" ] && profile="$cfg_prof"
    fi
    apply_dtb_profile "$profile"
    tune_cpu_governors
    setup_zram_1024m
    steer_ax_irqs 3 8
    log_info "1:2:1 isolation complete (profile=$profile, io_cpu=3, io_mask=0x8)"
    ;;
  stop)
    log_info "Stopping Piccolo-2go isolation hook"
    ;;
  restart|reload)
    "$0" stop
    "$0" start
    ;;
  *)
    printf "Usage: %s {start|stop|restart|reload}\n" "$0" >&2
    exit 1
    ;;
esac
