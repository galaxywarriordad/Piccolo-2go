# --- Boot Compression & Immutable SquashFS Root ---
CONFIG_KERNEL_LZ4=y
# CONFIG_KERNEL_GZIP is not set
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y

# --- Deterministic 1:2:1 Cortex-A35 Tickless Isolation & Preemption ---
CONFIG_PREEMPT=y
CONFIG_NO_HZ_FULL=y
CONFIG_RCU_NOCB_CPU=y
CONFIG_IRQ_FORCED_THREADING=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HZ_1000=y

# --- Cortex-A35 TLB HugePages (madvise), 1024 MB LZ4 ZRAM & 64 MB Panfrost CMA ---
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZSMALLOC=y
CONFIG_CMA=y
CONFIG_CMA_SIZE_MBYTES=64
CONFIG_CMA_ALIGNMENT=8

# --- Mali-G31 MP2 (Panfrost), RGA2-Lite 2D Blitter & Direct KMS/DRM MIPI DSI Scanout ---
CONFIG_DRM=y
CONFIG_DRM_PANFROST=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP=y
CONFIG_DRM_DW_MIPI_DSI=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_VIDEO_ROCKCHIP_RGA=y

# --- Bit-Perfect USB-C OTG Audio (HiBy FC3 1.3 Vrms) & RK817 Codec ---
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_SOC_ROCKCHIP=y
CONFIG_SND_SOC_ROCKCHIP_I2S=y
CONFIG_SND_SOC_RK817=y
CONFIG_MFD_RK808=y
CONFIG_REGULATOR_RK808=y
CONFIG_CHARGER_RK817=y
CONFIG_BATTERY_RK817=y

# --- Dual SD Storage (TF1 + TF2) & SARADC/GPIO Controls ---
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_EXFAT_FS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_ROCKCHIP_SARADC=y
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_EVDEV=y

# --- Purge Unused Silicon Blocks & Desktop Overhead ---
# CONFIG_VIDEO_ROCKCHIP_ISP1 is not set
# CONFIG_CRYPTO_DEV_ROCKCHIP is not set
# CONFIG_BT is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_SOUND_OSS_CORE is not set
